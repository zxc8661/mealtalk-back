# Spring Boot loads a sibling .env as local properties. Copy this file to .env.
DB_URL=jdbc:postgresql://localhost:5433/mealtalk
DB_USERNAME=mealtalk
DB_PASSWORD=mealtalk

# Leave the E2E profile unset for normal local Google login.
# Tests activate the E2E fixture profile themselves when required.

GOOGLE_CLIENT_ID=your-google-client-id
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:8081
# data.go.kr 일반 인증키 for 식품의약품안전처_식품영양성분DB정보.
# Paste the portal key as issued; the backend decodes it before sending.
# Keep it only in the ignored .env file, never in the Expo app.
FOOD_API_KEY=your-data-go-kr-service-key

# Private Cloudflare R2 bucket for meal photos (S3-compatible API).
# Backend-only: never copy any of these into the Expo app or an EXPO_PUBLIC_* value.
# Leave them blank until the bucket exists - the API starts fine without them and
# simply refuses photo uploads with a storage error until they are filled in.
# The bucket must stay private; the API streams photo bytes to authenticated owners.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-private-meal-photo-bucket
# R2 ignores the region; "auto" is its own default and rarely needs changing.
R2_REGION=auto
